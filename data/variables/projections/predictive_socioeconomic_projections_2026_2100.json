{
  "metadata": {
    "title": "Ether Predictive & Future Cliodynamic Projections Suite (2026-2100)",
    "version": "2.0.0",
    "description": "Harmonized multi-variable predictive benchmark trajectories from international integrated assessment models (IAMs), climate intercomparisons, and demographic agencies for comparative future evaluation (2026-2100).",
    "compiler": "Ether Epistemic Falsification & Predictive Evaluation Kernel",
    "creationDate": "2026-10-29",
    "models": {
      "PREDICTIVE_SSP1": {
        "id": "PREDICTIVE_SSP1",
        "name": "Sustainability & Rapid Decarbonization (IIASA SSP1 / IEA NZE 2050)",
        "agency": "IIASA, IPCC AR6 WGIII, International Energy Agency (IEA)",
        "scenario": "SSP1-1.9 / SSP1-2.6 & Net Zero Emissions by 2050",
        "doi": "10.1016/j.gloenvcha.2016.05.009",
        "description": "Green growth transition, accelerated electrification, circular economy, resource decoupling, and demographic peak followed by sustainable stabilization."
      },
      "PREDICTIVE_SSP2": {
        "id": "PREDICTIVE_SSP2",
        "name": "Middle-of-the-Road Trend Continuity (UN WPP 2024 / IIASA SSP2 / IEA STEPS)",
        "agency": "United Nations DESA Population Division, IIASA, IEA",
        "scenario": "SSP2-4.5 Intermediate Forcing & UN WPP 2024 Median Variant",
        "doi": "10.18356/9789210027137",
        "description": "Historical trend extrapolation: moderate economic growth, gradual energy efficiency improvements, and demographic plateauing near 10.3 billion."
      },
      "PREDICTIVE_SSP3_WORLD3": {
        "id": "PREDICTIVE_SSP3_WORLD3",
        "name": "Regional Rivalry & Resource Limits (Club of Rome World3 BAU2 / IPCC SSP3)",
        "agency": "Club of Rome / Herrington (2021) / IIASA SSP3",
        "scenario": "World3 Business-as-Usual 2 (BAU2) & SSP3-7.0 Regional Rivalry",
        "doi": "10.1111/jiec.13084",
        "description": "Declining fossil fuel EROI, supply chain friction, mineral resource degradation, agricultural strain, and industrial contraction post-2045."
      },
      "PREDICTIVE_SSP4": {
        "id": "PREDICTIVE_SSP4",
        "name": "Inequality - A Road Divided (IIASA SSP4 / GCAM4)",
        "agency": "Pacific Northwest National Laboratory (PNNL), IIASA, IPCC AR6",
        "scenario": "SSP4-3.4 / SSP4-6.0 High Inequality & Social Stratification",
        "doi": "10.1016/j.gloenvcha.2016.05.009",
        "description": "High international and intra-national inequality: high-tech connected elite coexisting with marginalized majority; lower education investments; slower demographic transition in developing regions."
      },
      "PREDICTIVE_SSP5": {
        "id": "PREDICTIVE_SSP5",
        "name": "Fossil-Fueled High Development (IIASA SSP5-8.5 / REMIND-MAGPIE)",
        "agency": "Potsdam Institute for Climate Impact Research (PIK), IIASA",
        "scenario": "SSP5-8.5 Extreme Radiative Forcing",
        "doi": "10.1016/j.gloenvcha.2016.05.009",
        "description": "Unconstrained fossil energy extraction, heavy industrial expansion, rapid technological innovation, severe climate warming (>4.0\u00c2\u00b0C by 2100)."
      }
    }
  },
